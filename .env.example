VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Branding configurable (nombre y URL pública de la app)
# Sin estas vars se usan los defaults: nombre "Pritio", URL https://pritio.clipot.com.mx
VITE_APP_NAME=
VITE_APP_URL=https://pritio.clipot.com.mx

VITE_SENTRY_DSN=
VITE_BETA_MODE=true
VITE_SELF_HOSTED=false

# Feature flags
VITE_DONATIONS_ENABLED=false

# Edge Functions — Email (Resend recommended)
# Deploy: supabase functions deploy send-invite
# Secrets: supabase secrets set RESEND_API_KEY=xxx
# Or use SMTP:
# supabase secrets set SMTP_HOST=smtp.example.com SMTP_USER=xxx SMTP_PASS=xxx
SMTP_FROM=pritio@clipot.mx
SMTP_FROM_NAME=PRITIO

# App URL for invitation links (prod: https://pritio.clipot.com.mx)
APP_URL=http://localhost:5173

# Web Push Notifications (VAPID)
# Generate keys: npx web-push generate-vapid-keys
# Deploy: supabase functions deploy send-push
# Secrets: supabase secrets set VAPID_PUBLIC_KEY=xxx VAPID_PRIVATE_KEY=xxx VAPID_SUBJECT=mailto:admin@pritio.com.mx
VITE_VAPID_PUBLIC_KEY=BIptfFmURd_BLBAsXkcDVZtTXtgIIjkWDy0Wu3lEmf0umj8zfGHTbXH96k3hZ0JcAZYqdF67OC3S77iRP7j6kWg

# Daily Digest (cron)
# Deploy with schedule: supabase functions deploy daily-digest --schedule "0 13 * * *"
# (runs daily at 13:00 UTC = 7:00 AM CDMX)
# Manual test: curl -X POST https://<project>.supabase.co/functions/v1/daily-digest -H "Authorization: Bearer <anon-key>"

# Task Notifications (assigned, updated, meeting_created, deadline_approaching, completed)
# Deploy: supabase functions deploy task-notifications
# Uses same Resend/SMTP secrets as send-invite

# Stripe Payments (billing por workspace, 3 tiers x moneda x ciclo)
# Deploy: supabase functions deploy stripe-checkout stripe-portal stripe-webhook sync-seats
# Secrets: supabase secrets set STRIPE_SECRET_KEY=xxx STRIPE_WEBHOOK_SECRET=xxx PUBLIC_APP_URL=https://app.pritio.com.mx \
#   STRIPE_PRICE_PRO_PERSONAL_MONTHLY_USD=price_xxx STRIPE_PRICE_PRO_PERSONAL_YEARLY_USD=price_xxx \
#   STRIPE_PRICE_PRO_PERSONAL_MONTHLY_MXN=price_xxx STRIPE_PRICE_PRO_PERSONAL_YEARLY_MXN=price_xxx \
#   STRIPE_PRICE_PRO_FAMILY_MONTHLY_USD=price_xxx STRIPE_PRICE_PRO_FAMILY_YEARLY_USD=price_xxx \
#   STRIPE_PRICE_PRO_FAMILY_MONTHLY_MXN=price_xxx STRIPE_PRICE_PRO_FAMILY_YEARLY_MXN=price_xxx \
#   STRIPE_PRICE_PRO_TEAM_MONTHLY_USD=price_xxx STRIPE_PRICE_PRO_TEAM_YEARLY_USD=price_xxx \
#   STRIPE_PRICE_PRO_TEAM_MONTHLY_MXN=price_xxx STRIPE_PRICE_PRO_TEAM_YEARLY_MXN=price_xxx
# For local dev, set the same values in .env (config.toml maps them via env(...)).
# Local webhook testing: stripe listen --forward-to localhost:54321/functions/v1/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_PERSONAL_MONTHLY_USD=
STRIPE_PRICE_PRO_PERSONAL_YEARLY_USD=
STRIPE_PRICE_PRO_PERSONAL_MONTHLY_MXN=
STRIPE_PRICE_PRO_PERSONAL_YEARLY_MXN=
STRIPE_PRICE_PRO_FAMILY_MONTHLY_USD=
STRIPE_PRICE_PRO_FAMILY_YEARLY_USD=
STRIPE_PRICE_PRO_FAMILY_MONTHLY_MXN=
STRIPE_PRICE_PRO_FAMILY_YEARLY_MXN=
STRIPE_PRICE_PRO_TEAM_MONTHLY_USD=
STRIPE_PRICE_PRO_TEAM_YEARLY_USD=
STRIPE_PRICE_PRO_TEAM_MONTHLY_MXN=
STRIPE_PRICE_PRO_TEAM_YEARLY_MXN=
# Public app URL used for Stripe success/cancel redirects (localhost during dev, prod: https://app.pritio.com.mx)
PUBLIC_APP_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────
# Asana integration (conectar e importar tareas)
# Deploy: supabase functions deploy asana-oauth asana-import
# Secrets: supabase secrets set ASANA_CLIENT_ID=xxx ASANA_CLIENT_SECRET=xxx
# Register an app in the Asana dev console (app.asana.com > My apps) and add this
# redirect URI (must match PUBLIC_APP_URL):  {PUBLIC_APP_URL}/oauth/asana/callback
# Scopes needed: tasks:read, projects:read, workspaces:read
# For local dev, set the same values in .env (config.toml maps them via env(...)).
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
